<view class="container222" style="background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%); min-height: 100vh; padding: 20rpx 0;">
  <view wx:if="{{!newsList}}" class="noData">
    <image class="logo" src="/static/images/nodata-message.png" mode="widthFix" />
    <view style="margin-top: 40rpx; font-weight: 500;">暂无产品数据</view>
  </view>
  <view wx:for="{{newsList}}" wx:for-index='id' wx:key="id" class="newsList" bindtap="goDetail" data-id="{{item.id}}">
    <view wx:if="{{item.pic}}" class="cover">
      <image class="cover-img" src="{{item.pic}}" mode="aspectFill" />
    </view>
    <view class="title">{{item.title}}</view>
    <view class="descript">{{item.descript}}</view>
  </view>
</view>