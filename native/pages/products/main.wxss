/* 产品页面 - 高端卡片设计 */
page {
  background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%);
}

.noData {  
  text-align: center;
  font-size: 28rpx;
  color: #a0aec0;
  width: 750rpx;
  padding-top: 200rpx;
}

.noData .logo {
  width: 400rpx;
  margin-top: 100rpx;
  opacity: 0.6;
  filter: grayscale(0.3);
}

.newsList {
  width: 690rpx;
  margin: 30rpx auto;
  padding: 0;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  transition: all 0.3s ease;
  border: 1rpx solid rgba(102, 126, 234, 0.08);
  overflow: hidden;
  position: relative;
}

.newsList::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.newsList:active {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.15);
}

.cover {
  width: 100%;
  height: 400rpx;
  position: relative;
  overflow: hidden;
}

.cover::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, transparent 50%, rgba(0, 0, 0, 0.15) 100%);
  pointer-events: none;
}

.cover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease;
}

.newsList:active .cover-img {
  transform: scale(1.05);
}

.title {
  margin-top: 0;
  padding: 32rpx 32rpx 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #2d3748;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  letter-spacing: 0.5rpx;
}

.descript {
  margin-top: 0;
  padding: 0 32rpx 32rpx;
  line-height: 1.8;
  font-size: 26rpx;
  color: #718096;
  display: -webkit-box;
}