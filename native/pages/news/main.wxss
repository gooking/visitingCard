/* 动态页面 - 优雅列表设计 */
page {
  background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%);
}

.noData {  
  text-align: center;
  font-size: 28rpx;
  color: #a0aec0;
  width: 750rpx;
  padding-top: 200rpx;
}

.noData .logo {
  width: 400rpx;
  margin-top: 100rpx;
  opacity: 0.6;
  filter: grayscale(0.3);
}

.newsList {
  width: 690rpx;
  margin: 24rpx auto;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(102, 126, 234, 0.06);
}

.newsList::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  opacity: 0.8;
}

.newsList:active {
  transform: translateX(8rpx);
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.12);
}

.newsList:active::before {
  opacity: 1;
}

.title {
  width: 100%;
  font-size: 32rpx;
  font-weight: 700;
  color: #2d3748;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  padding-left: 16rpx;
  letter-spacing: 0.5rpx;
}

.descriptDiv {
  margin-top: 20rpx;
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding-left: 16rpx;
}

.word {
  flex: 1;
  line-height: 1.8;
}

.descript {
  font-size: 26rpx;
  color: #718096;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.cover {
  width: 200rpx;
  height: 150rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

.cover::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-radius: 12rpx;
  pointer-events: none;
}

.cover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.newsList:active .cover-img {
  transform: scale(1.1);
}