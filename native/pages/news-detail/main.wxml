<import src="../../wxParse/wxParse.wxml" />

<view class="container" style="background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%); min-height: 100vh; padding: 20rpx 0 60rpx;">
  <view class="title">{{newsObject.title}}</view>
  <view class="datetime">📅 {{newsObject.dateAdd}}</view>
  <view class="wxparse-content">
    <template is="wxParse" data="{{wxParseData:article.nodes}}"/>
  </view>
</view>