@import "/template/login/index.wxss";

/* 名片页面 - 高端设计 */
.container {
  width: 750rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 50%, #f5f7fa 50%, #f5f7fa 100%);
  padding-bottom: 60rpx;
}

.max-width {
  width: 750rpx;
  position: relative;
}

.userinfo-avatar {
  width: 750rpx;
  height: 500rpx;
  object-fit: cover;
  mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 70%, rgba(0,0,0,0));
  -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 70%, rgba(0,0,0,0));
}

.profile-box {
  position: relative;
  width: 690rpx;
  margin: -80rpx auto 0;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(102, 126, 234, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.profile {
  text-align: left;
  padding: 48rpx 32rpx 32rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  border-bottom: 1rpx solid rgba(102, 126, 234, 0.1);
}

.profile .name {
  font-size: 48rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 2rpx;
}

.profile .position {
  font-size: 28rpx;
  margin-left: 24rpx;
  color: #8b95a5;
  padding: 8rpx 20rpx;
  background: rgba(102, 126, 234, 0.08);
  border-radius: 24rpx;
  margin-bottom: 4rpx;
}

.action-buttons {
  width: 750rpx;
  display: flex;
  justify-content: space-around;
  padding: 60rpx 0 40rpx;
  margin-top: 40rpx;
}

.action-buttons .button {
  flex: 1;
  text-align: center;
  position: relative;
}

.action-buttons .button button {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 100%;
  opacity: 0;
  z-index: 99;
}

.action-buttons .button::before {
  content: '';
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-radius: 50%;
  z-index: 0;
}

.action-buttons .button .img {
  width: 96rpx;
  height: 96rpx;
  display: block;
  margin: 0 auto;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 4rpx 12rpx rgba(102, 126, 234, 0.2));
}

.action-buttons .button .txt {
  font-size: 26rpx;
  display: block;
  margin-top: 20rpx;
  color: #4a5568;
  font-weight: 500;
}

.phone {
  text-align: left;
  padding: 32rpx;
  font-size: 28rpx;
  color: #4a5568;
}

.profile2 {
  text-align: left;
  padding: 32rpx;
  color: #4a5568;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.profile2 .name {
  font-size: 28rpx;
  width: 160rpx;
  font-weight: 600;
  color: #2d3748;
}

.profile2 .position {
  font-size: 26rpx;
  width: 400rpx;
  color: #718096;
}

.profile2 .action {
  font-size: 24rpx;
  width: 120rpx;
  color: #667eea;
}

.share {
  position: fixed;
  right: 0rpx;
  top: 600rpx;
  z-index: 100;
}

.sharempj {
  position: fixed;
  left: 0rpx;
  top: 60rpx;
  z-index: 100;
}

.share .shareimg {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.sharempj .shareimg {
  width: 90rpx;
  height: 60rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.shareFloatDiv1 {
  position: fixed;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10rpx);
  z-index: 999;
}

.shareFloatDiv2 {
  position: fixed;
  width: 100%;
  background: #ffffff;
  bottom: 0rpx;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.1);
  z-index: 1000;
}

.shareFloatDiv2 .p1 {
  padding: 60rpx 0;
  display: flex;
  flex-direction: row;
}

.shareFloatDiv2 .p1 .wx {
  font-size: 28rpx;
  flex: 1;
  text-align: center;
}

.shareFloatDiv2 .p1 .wx .shareimg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.2);
}

.shareFloatDiv2 .p2 {
  height: 16rpx;
  background: #f5f7fa;
}

.shareFloatDiv2 .p3 {
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  color: #718096;
  font-size: 28rpx;
}

.qrcode-box {
  padding: 60rpx 32rpx;
  text-align: center;
}

.qrcode {
  width: 360rpx;
  height: 360rpx;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(102, 126, 234, 0.2);
  border: 8rpx solid #ffffff;
  background: #ffffff;
}